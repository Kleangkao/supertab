# Names only. Copy this file to .env.local and fill in values there.
# .env.local is ignored by git.

# Gemini Interactions API. Leave blank to use the built-in shopping parser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Shopify Global Catalog needs no secret for product discovery.
# Set this to false to turn the provider off.
SHOPIFY_CATALOG_ENABLED=true
SHOPIFY_CATALOG_URL=https://catalog.shopify.com/api/ucp/mcp
SHOPIFY_UCP_PROFILE=https://shopify.dev/ucp/agent-profiles/2026-04-08/valid-with-capabilities.json
SHOPIFY_SHIP_TO_COUNTRY=US

# eBay Browse API. Both values are required. Discovery does not include purchase permission.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENVIRONMENT=production
EBAY_MARKETPLACE_ID=EBAY_US

# Leave SOLANA_RPC_URL blank to use the public mainnet endpoint.
SOLANA_RPC_URL=
SOLANA_CLUSTER=mainnet-beta

# DFlow dev quotes work without a key. Production quote-api.dflow.net refused unauthenticated calls.
DFLOW_QUOTE_BASE_URL=https://dev-quote-api.dflow.net
DFLOW_API_KEY=
DFLOW_SLIPPAGE_BPS=50

# Naming a payment provider does not connect one. The card rail stays unavailable.
PAYMENT_RAIL_PROVIDER=
