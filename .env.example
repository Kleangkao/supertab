# Names only. Copy this file to .env.local and fill in values there.
# .env.local is ignored by git.

# Gemini Interactions API. Leave blank to use the built-in shopping parser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Shopify Global Catalog needs no secret for product discovery.
# Set this to false to turn the provider off.
SHOPIFY_CATALOG_ENABLED=true
SHOPIFY_CATALOG_URL=https://catalog.shopify.com/api/ucp/mcp
SHOPIFY_UCP_PROFILE=https://shopify.dev/ucp/agent-profiles/2026-04-08/valid-with-capabilities.json
SHOPIFY_SHIP_TO_COUNTRY=US
# Optional authenticated, read-only merchant checkout verification.
# Obtain a Catalog access token through Shopify's official authentication flow.
# Never use a production card key or put buyer/payment details in these variables.
SHOPIFY_CHECKOUT_ACCESS_TOKEN=
# Alternatively authenticate at request time with existing Catalog credentials.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Comma-separated HTTPS merchant origins approved to receive this token; no paths.
SHOPIFY_CHECKOUT_ALLOWED_ORIGINS=
# Local single-user PC only: actual public buyer IP, never a made-up or private IP.
# Used only on same-origin localhost requests; do not copy into hosted deployments.
SHOPIFY_LOCAL_BUYER_IP=
# Hosted apps only: opt in to one header overwritten by your trusted proxy.
# Allowed: x-forwarded-for, x-real-ip, x-vercel-forwarded-for. Lists are rejected.
SHOPIFY_TRUSTED_BUYER_IP_HEADER=

# eBay Browse API. Both values are required. Discovery does not include purchase permission.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENVIRONMENT=production
EBAY_MARKETPLACE_ID=EBAY_US

# Leave SOLANA_RPC_URL blank to use the public mainnet endpoint.
# Shopping balance reads use this URL and require a mainnet genesis hash.
SOLANA_RPC_URL=
SOLANA_CLUSTER=mainnet-beta

# Devnet checkout only. Leave blank to use the public devnet endpoint.
# Never put a mainnet URL here. The merchant checks the genesis hash and
# refuses mainnet or testnet. API keys stay in this ignored file.
SOLANA_DEVNET_RPC_URL=

# Dev quotes work without a key. Production quotes use https://quote-api.dflow.net and DFLOW_API_KEY.
DFLOW_QUOTE_BASE_URL=https://dev-quote-api.dflow.net
DFLOW_API_KEY=
DFLOW_SLIPPAGE_BPS=50

# Bridge sandbox only. Leave blank until the dashboard issues a sandbox key.
# Production Bridge and real card numbers are not accepted.
BRIDGE_API_KEY=
BRIDGE_API_BASE_URL=https://api.sandbox.bridge.xyz
BRIDGE_WEBHOOK_SECRET=
