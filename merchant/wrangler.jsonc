{
  "name": "supertab-devnet-merchant",
  "main": "worker.ts",
  "compatibility_date": "2026-10-06",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "vars": {
    "GEMINI_DAILY_LIMIT": "120"
  },
  "durable_objects": {
    "bindings": [
      { "name": "MERCHANT", "class_name": "DevnetMerchantObject" },
      { "name": "SESSIONS", "class_name": "ShoppingSessionObject" },
      { "name": "GEMINI_BUDGET", "class_name": "GeminiBudgetObject" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DevnetMerchantObject", "ShoppingSessionObject", "GeminiBudgetObject"]
    }
  ]
}
